{
  "name": "profile",
  "version": "0.1.0",
  "private": true,
  "description": "Structured, persistent source of truth for a person's experiences",
  "type": "module",
  "imports": {
    "#src/*": {
      "production": "./dist/*",
      "default": "./src/*"
    },
    "#tests/*": "./tests/*",
    "#config/*": "./config/*",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --conditions=production dist/index.js",
    "dev": "tsx scripts/dev.ts",
    "db:generate": "drizzle-kit generate --config=config/drizzle.ts",
    "db:migrate": "drizzle-kit migrate --config=config/drizzle.ts",
    "db:check": "tsx scripts/check-migrations.ts",
    "db:studio": "drizzle-kit studio --config=config/drizzle.ts",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "test": "vitest run --config config/vitest.ts",
    "test:db": "vitest run --config config/vitest-db.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "license": "ISC",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "1.0.0-rc.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "drizzle-orm": "1.0.0-rc.6",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
