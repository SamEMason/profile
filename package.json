{
  "name": "profile",
  "version": "0.1.0",
  "private": true,
  "description": "Structured, persistent source of truth for a person's experiences",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx scripts/dev.ts",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "license": "ISC",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
